import React, { useState } from 'react';
import { View, Text, TouchableOpacity, StyleSheet } from 'react-native';

export default function App() {
  const [votosA, setVotosA] = useState(0);
  const [votosB, setVotosB] = useState(0);
  const [votosC, setVotosC] = useState(0);

  const totalGeral = votosA + votosB + votosC;

  const verificarLideranca = () => {
    if (totalGeral === 0) return 'Nenhum voto registrado';
    const max = Math.max(votosA, votosB, votosC);
    const lideres = [];
    if (votosA === max) lideres.push('Candidato A');
    if (votosB === max) lideres.push('Candidato B');
    if (votosC === max) lideres.push('Candidato C');

    if (lideres.length > 1) {
      return `Empate na liderança: ${lideres.join(' e ')}`;
    }
    return `Mais votado: ${lideres[0]}`;
  };

  return (
    <View style={styles.container}>
      <Text style={styles.titulo}>Eleição Estudantil</Text>

      <TouchableOpacity style={styles.botao} onPress={() => setVotosA(votosA + 1)}>
        <Text style={styles.textoBotao}>Votar Candidato A ({votosA})</Text>
      </TouchableOpacity>

      <TouchableOpacity style={styles.botao} onPress={() => setVotosB(votosB + 1)}>
        <Text style={styles.textoBotao}>Votar Candidato B ({votosB})</Text>
      </TouchableOpacity>

      <TouchableOpacity style={styles.botao} onPress={() => setVotosC(votosC + 1)}>
        <Text style={styles.textoBotao}>Votar Candidato C ({votosC})</Text>
      </TouchableOpacity>

      <View style={styles.resultado}>
        <Text style={styles.textoResultado}>Total Geral: {totalGeral}</Text>
        <Text style={styles.textoDestaque}>{verificarLideranca()}</Text>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: 'center', padding: 20, backgroundColor: '#f5f5f5' },
  titulo: { fontSize: 22, fontWeight: 'bold', textAlign: 'center', marginBottom: 20 },
  botao: { backgroundColor: '#0066cc', padding: 15, borderRadius: 8, marginBottom: 10 },
  textoBotao: { color: '#fff', textAlign: 'center', fontWeight: 'bold', fontSize: 16 },
  resultado: { marginTop: 20, padding: 15, backgroundColor: '#fff', borderRadius: 8 },
  textoResultado: { fontSize: 16, marginBottom: 5 },
  textoDestaque: { fontSize: 18, fontWeight: 'bold', color: '#0066cc' },
});
